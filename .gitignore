# Per-target run artifacts (logs/<dc-ip>/…) — never commit; keep the dir
logs/*
!logs/.gitkeep
ntds*
secrets
*.ccache
*.kirbi
*.pfx

# Cracked material / wordlists
hash*.txt
rockyou*

# BloodHound dumps (keep only tiny tracked fixtures if ever needed)
*.zip

# Secrets / env
docker/.env
.env
!docker/.env.example

# conf/ ships *.example templates only; the live copies the agent writes
# per lab (real hosts, krb5 realm, wordlist) stay untracked.
conf/*
!conf/*.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
